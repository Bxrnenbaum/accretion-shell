* {
	bg: {{color.bg}};
	surface: {{color.bgElevated}};
	fg: {{color.fg}};
	cream: {{color.fg}};
	muted: {{color.fgMuted}};
	accent: {{color.accent}};
	border: {{color.border}};
	input-border: {{color.border}};
	selected: {{color.bgElevated}};
	active-selected: {{color.accent}};
	urgent-selected: {{color.error}};
	font: "sans 11";
	prompt-font: "monospace Bold 11";
	window-width: 45%;
	window-radius: 24px 24px 0px 0px;
	window-padding: 18px;
	input-radius: 12px;
	input-padding: 12px 14px;
	panel-spacing: 12px;
	list-padding: 2px 0px;
	element-padding: 9px 12px;
	element-radius: 10px;
	icon-size: 26px;
}
