/* Accretion Shell — Rofi launcher */

@import "~/.config/rofi/colors.rasi"

* {
    font: @font;
    background-color: transparent;
    text-color: @fg;
}

window {
    location: south;
    anchor: south;
    x-offset: 0px;
    y-offset: 0px;

    width: @window-width;

    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: @window-radius;
    padding: @window-padding;

    transparency: "real";
}

mainbox {
    background-color: transparent;
    spacing: @panel-spacing;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @input-border;
    border-radius: @input-radius;
    padding: @input-padding;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @cream;
    font: @prompt-font;
}

entry {
    text-color: @fg;
    placeholder: "Search applications";
    placeholder-color: @muted;
    cursor: text;
}

listview {
    columns: 1;
    lines: 8;
    spacing: 3px;
    padding: @list-padding;
    scrollbar: false;
    dynamic: true;
    fixed-height: false;
    fixed-columns: true;
}

element {
    orientation: horizontal;
    padding: @element-padding;
    spacing: 12px;
    border: 1px;
    border-color: transparent;
    border-radius: @element-radius;
    background-color: transparent;
    children: [ element-icon, element-text ];
}

element normal.normal {
    background-color: transparent;
    text-color: @muted;
}

element normal.active {
    background-color: transparent;
    text-color: @accent;
}

element normal.urgent {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    border-color: @border;
    text-color: @cream;
}

element selected.active {
    background-color: @active-selected;
    text-color: @cream;
}

element selected.urgent {
    background-color: @urgent-selected;
    text-color: @cream;
}

element-icon {
    size: @icon-size;
    background-color: transparent;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

message {
    background-color: @surface;
    border-radius: 10px;
    padding: 10px 12px;
}

textbox {
    text-color: @fg;
}
