* {
	bg: #0B1B26;
	surface: #252B38;
	fg: #F2E8D5;
	cream: #F2E8D5;
	muted: #7F9AAE;
	accent: #89B4FA;
	border: #343C4D;
	input-border: #343C4D;
	selected: #252B38;
	active-selected: #89B4FA;
	urgent-selected: #C97B7B;
	font: "sans 11";
	prompt-font: "monospace Bold 11";
	window-width: 45%;
	window-radius: 24px 24px 0px 0px;
	window-padding: 18px;
	input-radius: 12px;
	input-padding: 12px 14px;
	panel-spacing: 12px;
	list-padding: 2px 0px;
	element-padding: 9px 12px;
	element-radius: 10px;
	icon-size: 26px;
}
